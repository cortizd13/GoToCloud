# Gemini API (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_TEXT_MODEL=gemini-2.0-flash

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# URL pública del servidor (ngrok tunnel o dominio propio)
# Ejemplo ngrok: https://abc123.ngrok-free.app
PUBLIC_URL=https://your-public-url.com

# Puerto (opcional, uvicorn usa 8000 por defecto)
PORT=8000

# Twilio (para llamadas de voz, WhatsApp y seguimiento post-llamada)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# Sandbox WhatsApp (Twilio Sandbox): whatsapp:+14155238886
# Número propio aprobado (WhatsApp Business API): whatsapp:+57xxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
